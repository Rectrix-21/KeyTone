NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Installers are published as GitHub Release assets (see the "studio-v1" release),
# not committed to the repo -- GitHub rejects files over 100MB. Bump the tag in the
# URL (and re-publish a release) whenever a new build is cut.
NEXT_PUBLIC_KEYTONE_STUDIO_WIN_URL=https://github.com/Rectrix-21/KeyTone/releases/download/studio-v1/KeyTone-Studio-Setup.exe
NEXT_PUBLIC_KEYTONE_STUDIO_MAC_URL=https://github.com/Rectrix-21/KeyTone/releases/download/studio-v1/KeyTone-Studio.dmg
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-only (never NEXT_PUBLIC_). Used by /api/auth/delete-account to remove a user.
# Supabase dashboard -> Project Settings -> API -> service_role key (secret).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_STRIPE_PRICE_ID=price_XXXXXXXXXXXX