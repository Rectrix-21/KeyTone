{
  "name": "keytone-studio",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.keytone.studio.local",
    "productName": "KeyTone Studio",
    "icon": "assets/logo.png",
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg/bin/ffmpeg.exe"
      },
      {
        "from": "..\\..\\public\\logo.png",
        "to": "assets/logo.png"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "uploads/**",
      "output/**"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg"
      ],
      "artifactName": "KeyTone-Studio.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "KeyTone-Studio-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
